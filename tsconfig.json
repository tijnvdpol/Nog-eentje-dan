{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "types": ["node", "vite/client"], "isolatedModules": true,
    "noUncheckedIndexedAccess": false, "resolveJsonModule": true
  },
  "include": ["src", "tests", "scripts", "*.ts"]
}
